# Django
DJANGO_ENV=prod
DEBUG=False
DJANGO_SECRET_KEY=change-me-very-long-random
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=switchmonitor
DB_USER=switchmonitor
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# Celery / Broker
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_WORKER_MAX_MEMORY_PER_CHILD=262144
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180
CELERY_VISIBILITY_TIMEOUT=21600
CELERY_ENABLE_DEAD_LETTER=False

# Polling load control
POLL_ALL_DEVICES_INTERVAL_SEC=300
POLL_ALL_DEVICES_ASYNC_DISPATCH=1
POLL_MAX_QUEUE_DEPTH=20000
POLL_BATCH_SIZE=500
DISCOVERY_BATCH_SIZE=200

# Optional legacy jobs
LEGACY_TASKS_ENABLED=False

# Logging
LOG_JSON=True
LOG_LEVEL=INFO

# SNMP defaults
SNMP_DEFAULT_COMMUNITY_RO=public
SNMP_DEFAULT_COMMUNITY_RW=private

# Optional integrations
ZABBIX_URL=
ZABBIX_TOKEN=
ZABBIX_VERIFY_SSL=True

# Alerting
ALERT_WEBHOOK_URL=
ALERT_NOTIFY_TIMEOUT=5
ALERT_EMAIL_FROM=monitoring@example.com
ALERT_EMAIL_TO=
ALERT_MIN_CONSECUTIVE_BREACH=2
ALERT_MIN_CONSECUTIVE_RECOVERY=2

# Nginx publish port
NGINX_PORT=80
