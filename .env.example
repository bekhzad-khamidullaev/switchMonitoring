# Django
DJANGO_ENV=dev
DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
HOST_AUTO_TRUST_CSRF_FROM_ALLOWED_HOSTS=True
HOST_TRUST_CSRF_HTTP_FOR_LOCALHOST=True
HOST_TRUST_CSRF_HTTP_FOR_ALL=False

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=snmp
DB_USER=snmp
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery/Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
POLL_ALL_DEVICES_INTERVAL_SEC=300
POLL_ALL_DEVICES_ASYNC_DISPATCH=True
POLL_BATCH_SIZE=500
POLL_MAX_QUEUE_DEPTH=20000
DISCOVERY_BATCH_SIZE=200
DISCOVERY_MAX_QUEUE_DEPTH=1000
LEGACY_TASKS_ENABLED=False
METRIC_SAMPLE_RETENTION_ENABLED=False
METRIC_SAMPLE_RETENTION_DAYS=30
METRIC_SAMPLE_RETENTION_BATCH_SIZE=20000
METRIC_SAMPLE_RETENTION_MAX_BATCHES=10
METRIC_SAMPLE_RETENTION_HOUR=2
METRIC_SAMPLE_RETENTION_MINUTE=20

# Logging
LOG_JSON=True
LOG_LEVEL=INFO

# SNMP defaults for new devices
SNMP_DEFAULT_COMMUNITY_RO=public
SNMP_DEFAULT_COMMUNITY_RW=private

# Zabbix sync
ZABBIX_URL=https://monitoring.example.com/api_jsonrpc.php
ZABBIX_TOKEN=f676a58bd5f054233e230ddda8e317e4024091afa5a60d766e89c6de285a276f
ZABBIX_VERIFY_SSL=True

# Production security flags
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY
USE_X_FORWARDED_PROTO=False

# Alerting
ALERT_WEBHOOK_URL=
ALERT_NOTIFY_TIMEOUT=5
ALERT_EMAIL_FROM=monitoring@example.com
ALERT_EMAIL_TO=
ALERT_MIN_CONSECUTIVE_BREACH=2
ALERT_MIN_CONSECUTIVE_RECOVERY=2
