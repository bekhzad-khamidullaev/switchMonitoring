# Django
DJANGO_ENV=dev
DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=snmp
DB_USER=snmp
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Celery/Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
POLL_ALL_DEVICES_INTERVAL_SEC=300
LEGACY_TASKS_ENABLED=False

# Logging
LOG_JSON=True
LOG_LEVEL=INFO

# SNMP defaults for new devices
SNMP_DEFAULT_COMMUNITY_RO=public
SNMP_DEFAULT_COMMUNITY_RW=private

# Zabbix sync
ZABBIX_URL=https://monitoring.example.com/api_jsonrpc.php
ZABBIX_TOKEN=change-me
ZABBIX_VERIFY_SSL=True

# Production security flags
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
X_FRAME_OPTIONS=DENY
USE_X_FORWARDED_PROTO=False

# Alerting
ALERT_WEBHOOK_URL=
ALERT_NOTIFY_TIMEOUT=5
ALERT_EMAIL_FROM=monitoring@example.com
ALERT_EMAIL_TO=
ALERT_MIN_CONSECUTIVE_BREACH=2
ALERT_MIN_CONSECUTIVE_RECOVERY=2
